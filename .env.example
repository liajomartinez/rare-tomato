# Copy this file to .env and fill in your own values. Never commit .env.
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=

# WorkOS (auth) and Neon (database), added when those spikes start
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
DATABASE_URL=
# Public address of our MCP endpoint (defaults to the Vercel address) and the WorkOS AuthKit domain
MCP_RESOURCE_URL=
AUTHKIT_DOMAIN=

MCP_ALLOWED_HOSTS=

# Website sign-in (WorkOS AuthKit). The cookie password must be at least 32 random characters.
WORKOS_COOKIE_PASSWORD=
# How long the sign-in cookie lasts, in seconds. Use 2592000 (30 days); the library default is 400 days.
WORKOS_COOKIE_MAX_AGE=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=
# Set to true to require a known person and an active connection on /mcp (off = unchanged behavior)
CONNECTIONS_ENFORCED=
DATABASE_URL_TEST=

# Encrypts each person's stored details. 32 random bytes, base64. If lost, encrypted data cannot be recovered (see ADR 0016).
MASTER_KEY=
# Only during a key change: the old master key
MASTER_KEY_PREVIOUS=

# The demo agent's token (written by npm run demo:setup). Only the demo agent uses bearer tokens.
DEMO_AGENT_TOKEN=
# Set to true to let our own bearer tokens in (demo agent and local testing)
BEARER_ENABLED=
# The live database address, so demo:setup can refuse to run against it
LIVE_DATABASE_URL=
