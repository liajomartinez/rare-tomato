{
  "name": "agent-care",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "demo:jev": "node --env-file=.env demo-agent/jev-call.mts",
    "spike:db": "node --env-file=.env demo-agent/db-spike.mts",
    "dev:test": "node scripts/with-test-db.mjs npx next dev",
    "seed:rules-demo": "node scripts/with-test-db.mjs node node_modules/vitest/vitest.mjs run --config vitest.scripts.config.mts scripts/seed-rules-demo.script.ts --disableConsoleIntercept",
    "eval:marketplace": "node scripts/with-test-db.mjs node node_modules/vitest/vitest.mjs run --config vitest.scripts.config.mts scripts/eval-marketplace.script.ts --disableConsoleIntercept",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs migrate",
    "test:neon": "node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.neon.config.mts",
    "demo:setup": "node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.scripts.config.mts",
    "demo:agent": "node --env-file=.env demo-agent/care-agent.mts",
    "demo:feed": "node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.scripts.config.mts scripts/demo-feed.script.ts --disableConsoleIntercept",
    "experiment:armb": "node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.scripts.config.mts scripts/arm-b-counts.script.ts --disableConsoleIntercept",
    "experiment:counts": "node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.scripts.config.mts scripts/experiment-counts.script.ts --disableConsoleIntercept",
    "admin": "node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.scripts.config.mts scripts/admin.script.ts --disableConsoleIntercept",
    "admin:test": "node scripts/with-test-db.mjs node node_modules/vitest/vitest.mjs run --config vitest.scripts.config.mts scripts/admin.script.ts --disableConsoleIntercept",
    "eval:golden": "node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.scripts.config.mts scripts/eval-golden.script.ts --disableConsoleIntercept",
    "eval:injection": "node --env-file=.env node_modules/vitest/vitest.mjs run --config vitest.scripts.config.mts scripts/eval-injection-live.script.ts --disableConsoleIntercept",
    "check:rail": "node scripts/check-rail-layout.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@electric-sql/pglite": "^0.5.8",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "@neondatabase/serverless": "^1.1.0",
    "@workos-inc/authkit-nextjs": "^4.3.2",
    "@workos-inc/node": "^10.14.0",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
